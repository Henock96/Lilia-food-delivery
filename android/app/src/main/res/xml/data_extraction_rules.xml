<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : rien ne quitte l'appareil (SEC-09). Voir AndroidManifest.xml.
     Un nouveau téléphone repart d'une installation neuve : le livreur se
     reconnecte, ses courses vivent sur le serveur. Les positions GPS en
     attente d'envoi ne valent que pour le téléphone qui les a mesurées. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
